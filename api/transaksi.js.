const sendDigiflazz = require("../lib/digiflazz");

export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({
      success: false,
      message: "Method not allowed"
    });
  }

  const {
    SUPABASE_URL,
    SUPABASE_SECRET_KEY
  } = process.env;

  if (!SUPABASE_URL || !SUPABASE_SECRET_KEY) {
    return res.status(500).json({
      success: false,
      message: "Konfigurasi Supabase belum lengkap"
    });
  }

  const {
    sku,
    customer_no,
    ref_id
  } = req.body || {};

  if (
    typeof sku !== "string" ||
    typeof customer_no !== "string" ||
    typeof ref_id !== "string" ||
    !sku.trim() ||
    !customer_no.trim() ||
    !ref_id.trim()
  ) {
    return res.status(400).json({
      success: false,
      message: "Data pesanan belum lengkap"
    });
  }

  try {
    const baseUrl = SUPABASE_URL.replace(/\/+$/, "");

    const headers = {
      apikey: SUPABASE_SECRET_KEY,
      Authorization: `Bearer ${SUPABASE_SECRET_KEY}`,
      "Content-Type": "application/json"
    };

    // REF_ID HARUS MERUPAKAN ORDER_ID DI DATABASE
    const params = new URLSearchParams({
      order_id: `eq.${ref_id}`,
      select: "order_id,sku,customer_no,payment_status,topup_status",
      limit: "1"
    });

    const findResponse = await fetch(
      `${baseUrl}/rest/v1/orders?${params}`,
      { headers }
    );

    if (!findResponse.ok) {
      throw new Error(await findResponse.text());
    }

    const orders = await findResponse.json();
    const order = orders[0];

    if (!order) {
      return res.status(404).json({
        success: false,
        message: "Pesanan tidak ditemukan"
      });
    }

    // VALIDASI DATA PESANAN
    if (
      order.sku !== sku ||
      order.customer_no !== customer_no
    ) {
      return res.status(400).json({
        success: false,
        message: "Data pesanan tidak cocok"
      });
    }

    // PEMBAYARAN WAJIB BERHASIL
    if (order.payment_status !== "paid") {
      return res.status(402).json({
        success: false,
        message: "Pembayaran belum berhasil"
      });
    }

    // KLAIM PESANAN HANYA SATU KALI
    const claimResponse = await fetch(
      `${baseUrl}/rest/v1/orders?order_id=eq.${encodeURIComponent(ref_id)}&payment_status=eq.paid&topup_status=eq.pending&select=order_id,sku,customer_no`,
      {
        method: "PATCH",
        headers: {
          ...headers,
          Prefer: "return=representation"
        },
        body: JSON.stringify({
          topup_status: "processing"
        })
      }
    );

    const claimed = await claimResponse.json();

    if (!claimResponse.ok) {
      throw new Error(JSON.stringify(claimed));
    }

    if (!claimed.length) {
      return res.status(409).json({
        success: false,
        message: "Pesanan sudah diproses atau sedang diproses",
        order_id: ref_id
      });
    }

    // KIRIM MELALUI PROXY NODE4
    let result;

    try {
      result = await sendDigiflazz(claimed[0]);
    } catch (error) {
      console.error("DIGIFLAZZ_SEND_ERROR:", error.message);

      return res.status(200).json({
        success: true,
        message: "Hasil pengiriman belum dapat dipastikan. Perlu pemeriksaan.",
        order_id: ref_id,
        topup_status: "processing"
      });
    }

    const status = String(result?.status || "").toLowerCase();

    let topupStatus = "processing";

    if (status === "sukses") {
      topupStatus = "success";
    } else if (status === "gagal") {
      topupStatus = "failed";
    }

    // SIMPAN HASIL TRANSAKSI
    const saveResponse = await fetch(
      `${baseUrl}/rest/v1/orders?order_id=eq.${encodeURIComponent(ref_id)}&topup_status=eq.processing`,
      {
        method: "PATCH",
        headers: {
          ...headers,
          Prefer: "return=minimal"
        },
        body: JSON.stringify({
          topup_status: topupStatus
        })
      }
    );

    if (!saveResponse.ok) {
      throw new Error(await saveResponse.text());
    }

    return res.status(200).json({
      success: true,
      order_id: ref_id,
      topup_status: topupStatus,
      digiflazz_status: result.status
    });

  } catch (error) {
    console.error("TRANSAKSI_ERROR:", error.message);

    return res.status(500).json({
      success: false,
      message: "Terjadi kesalahan saat memproses transaksi"
    });
  }
}

